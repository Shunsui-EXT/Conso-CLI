# Conso backend (extracted from the extension; override only if it changes)
SUPABASE_URL=https://jzxlayjrsdbyzykuiqns.supabase.co
SUPABASE_KEY=sb_publishable_clAiRg6ffCznEAtg_bn19Q_yY0W5Hyd
CONSO_WEB=https://www.conso.xyz

# Identity generation
# Catch-all / disposable domain used for account emails.
EMAIL_DOMAIN=
DISPLAY_NAME_PREFIX=user
PASSWORD_LENGTH=16

# Concurrency + pacing
CONCURRENCY=4
MAX_CONCURRENCY=16
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MIN_DELAY_SECONDS=1.5
MAX_DELAY_SECONDS=6.0

# Transport fingerprint
IMPERSONATE=chrome
USER_AGENT=

# Proxy pool (comma-separated HTTP/SOCKS5 URLs). Empty = direct.
PROXY_URLS=

# Verification adapter: none | imap | tempmail | mailtm | ncaori | temptf
#   temptf  -> temp.tf real Gmail/Outlook/Hotmail aliases (RECOMMENDED: these
#              domains pass Conso's allowlist; no API key; OTP arrives here)
#   mailtm  -> mail.tm (free, no key; domain uberip.com is BLOCKED by Conso)
#   ncaori  -> temp-mail.ncaori.my.id (26 domains; needs NCAORI_API_KEY)
VERIFIER=none
TEMPTF_PROVIDER=gmail

# CAPTCHA — Conso enforces Cloudflare Turnstile on ALL Supabase auth endpoints
# (signup / password login / OTP). sitekey = 0x4AAAAAAEzmjKoKI6TA61_6
# Provider: none | service | capsolver | 2captcha | manual
#   service -> self-hosted captcha-solver sidecar (waguriagentic/captcha-solver)
CAPTCHA_PROVIDER=none
CAPTCHA_TOKEN=
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
# service provider:
SOLVER_URL=http://127.0.0.1:8877
SOLVER_TOKEN=
SOLVER_REAL_PAGE=1
CONSO_REDIRECT_URI=https://bjibbmkefnaamkenamdppfengeepadpi.chromiumapp.org/
# optional: solve+verify in one call (sends the token straight to Supabase)
CAPTCHA_VERIFY_URL=
CAPTCHA_VERIFY_SECRET=

# Ncaori Mail+ (VERIFIER=ncaori)
NCAORI_API=https://temp-mail.ncaori.my.id
NCAORI_API_KEY=

# IMAP (catch-all mailbox) — used when VERIFIER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_FILTER=

# TempMail API — used when VERIFIER=tempmail
TEMPMAIL_API=
TEMPMAIL_KEY=

# Storage
DATA_DIR=data
LOGS_DIR=logs
