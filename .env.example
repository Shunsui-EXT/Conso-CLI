# Conso backend (extracted from the extension; override only if it changes)
SUPABASE_URL=https://jzxlayjrsdbyzykuiqns.supabase.co
SUPABASE_KEY=sb_publishable_clAiRg6ffCznEAtg_bn19Q_yY0W5Hyd
CONSO_WEB=https://www.conso.xyz

# Identity generation
# Catch-all / disposable domain used for account emails.
EMAIL_DOMAIN=
DISPLAY_NAME_PREFIX=user
PASSWORD_LENGTH=16

# Concurrency + pacing
CONCURRENCY=4
MAX_CONCURRENCY=16
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MIN_DELAY_SECONDS=1.5
MAX_DELAY_SECONDS=6.0

# Transport fingerprint
IMPERSONATE=chrome
USER_AGENT=

# Proxy pool (comma-separated HTTP/SOCKS5 URLs). Empty = direct.
PROXY_URLS=

# Verification adapter: none | imap | tempmail
VERIFIER=none

# CAPTCHA — Conso enforces Cloudflare Turnstile on ALL Supabase auth endpoints
# (signup / password login / OTP). sitekey = 0x4AAAAAAEzmjKoKI6TA61_6
# Provider: none | capsolver | 2captcha | manual
CAPTCHA_PROVIDER=none
CAPTCHA_TOKEN=
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=

# IMAP (catch-all mailbox) — used when VERIFIER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_FILTER=

# TempMail API — used when VERIFIER=tempmail
TEMPMAIL_API=
TEMPMAIL_KEY=

# Storage
DATA_DIR=data
LOGS_DIR=logs
